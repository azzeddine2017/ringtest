#!/usr/bin/env bash
RING_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$RING_ROOT/tools/ringpm/packages/ringtest/main.ring" ]; then
    RINGTEST_PKG="$RING_ROOT/tools/ringpm/packages/ringtest"
elif [ -f "$RING_ROOT/tools/ringtest/main.ring" ]; then
    RINGTEST_PKG="$RING_ROOT/tools/ringtest"
elif [ -f "$RING_ROOT/main.ring" ]; then
    RINGTEST_PKG="$RING_ROOT"
elif [ -f "$RING_ROOT/../main.ring" ]; then
    RINGTEST_PKG="$(cd "$RING_ROOT/.." && pwd)"
else
    echo "Error: ringtest package files not found."
    exit 1
fi

export RINGTEST_CALLER_DIR="$(pwd)"
export RINGTEST_HOME="$RINGTEST_PKG"

cd "$RINGTEST_PKG"
ring main.ring "$@"
EXIT_CODE=$?
cd "$RINGTEST_CALLER_DIR"
exit $EXIT_CODE